{
  "experiments": {
    "inria_digital_hiding": {
      "description": "INRIA-Person hiding attack: a white-box AdvPatch-style patch (side 0.2 x person box diagonal) on every annotated person, protected detector Faster R-CNN. Benefit: person mAP.5 / AR on attacked images. Constraint: person mAP.5 / AR on clean images (a defense more than 0.05 clean mAP.5 below the undefended detector is scored as failed).",
      "weight": 0.4,
      "primary_metric": "attack_mAP5",
      "metrics": {
        "attack_mAP5": {
          "higher_is_better": true,
          "coefficient": 1.0,
          "description": "COCO-style person AP at IoU 0.5 on hiding-attacked images."
        },
        "attack_AR": {
          "higher_is_better": true,
          "coefficient": 0.5,
          "description": "COCO AR@100 (IoU 0.50:0.95) for persons on hiding-attacked images."
        },
        "clean_mAP5": {
          "higher_is_better": true,
          "coefficient": 0.5,
          "description": "Person AP at IoU 0.5 on clean images; the paper's 'without sacrificing clean performance' constraint (hard gate at -0.05 vs. no defense, plus this scored term)."
        },
        "clean_AR": {
          "higher_is_better": true,
          "coefficient": 0.15,
          "description": "Person AR@100 on clean images."
        }
      },
      "results": {
        "vanilla": {
          "type": "baseline",
          "attack_mAP5": 0.51,
          "attack_AR": 0.546,
          "clean_mAP5": 0.963,
          "clean_AR": 0.722
        },
        "objectseeker": {
          "type": "baseline",
          "attack_mAP5": 0.184,
          "attack_AR": 0.152,
          "clean_mAP5": 0.886,
          "clean_AR": 0.65
        },
