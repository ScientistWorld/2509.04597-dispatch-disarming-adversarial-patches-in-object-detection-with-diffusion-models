    "inria_hiding_large_patch": {
      "description": "Same hiding attack with larger patches (side 0.3 x person box diagonal), where the paper reports all defenses degrading (Appendix A.5, Figure 10). Person mAP.5 / AR on attacked images.",
      "weight": 0.25,
      "primary_metric": "attack_mAP5",
      "metrics": {
        "attack_mAP5": {
          "higher_is_better": true,
          "coefficient": 1.0,
          "description": "Person AP at IoU 0.5 on images with large hiding patches."
        },
        "attack_AR": {
          "higher_is_better": true,
          "coefficient": 0.5,
          "description": "Person AR@100 (IoU 0.50:0.95) on images with large hiding patches."
        }
      },
      "results": {
        "vanilla": {
          "type": "baseline",
          "attack_mAP5": 0.0318,
          "attack_AR": 0.1515
        },
        "dispatch": {
          "type": "proposed",
          "attack_mAP5": 0.4135,
          "attack_AR": 0.4801
        }
      },
      "notes": "The paper reports this regime only as a YOLOv3 curve (Figure 10), not on this detector; results here are the reproduced hidden-test values of this gym (scaled substitute), the paper's statements are kept under _paper_reported.",
      "_paper_reported": {
        "figure10_yolov3_advpatch_scale_0.3": {
          "vanilla_mAP5": "< 0.10",
          "dispatch_mAP5": "> 0.60",
          "nutnet": "> 0.60, below DISPATCH",
          "pad": "degrades with patch size"
        }
      }
    },
    "creating_digital": {
      "description": "Creating attack: a targeted white-box patch (stop sign or umbrella) in empty background, degraded by a print-and-capture transform (APRICOT-style physical patch). APRICOT protocol: lower attack success rate and lower patch-as-ground-truth mAP.5 are better; person mAP.5 on the same images is the preservation constraint (also gated at -0.05 vs. no defense).",
      "weight": 0.35,
      "primary_metric": "untargeted_ASR",
      "metrics": {
        "targeted_mAP5": {
          "higher_is_better": false,
          "coefficient": -0.4,
          "description": "AP at IoU 0.5 of wrong boxes of the target class against the patch box."
        },
        "targeted_ASR": {
          "higher_is_better": false,
          "coefficient": -0.6,
          "description": "Fraction of creating images with a wrong target-class box, confidence > 0.3, IoU >= 0.1 with the patch."
        },
        "untargeted_mAP5": {
          "higher_is_better": false,
          "coefficient": -0.6,
          "description": "AP at IoU 0.5 of wrong boxes of any class against the patch box."
        },
        "untargeted_ASR": {
          "higher_is_better": false,
          "coefficient": -1.0,
          "description": "Fraction of creating images with a wrong box of any class, confidence > 0.3, IoU >= 0.1 with the patch."
        },
        "object_mAP5": {
          "higher_is_better": true,
          "coefficient": 0.1,
          "description": "Person AP at IoU 0.5 on creating-attack images; a guard (hard gate at -0.05 vs. no defense). Honest defenses sit within seed noise of the undefended detector, so its scored coefficient is small."
        }
      },
      "results": {
        "vanilla": {
          "type": "baseline",
          "targeted_mAP5": 0.9901,
          "targeted_ASR": 0.9917,
          "untargeted_mAP5": 0.9901,
          "untargeted_ASR": 0.9917,
          "object_mAP5": 0.9912
        },
        "dispatch": {
          "type": "proposed",
